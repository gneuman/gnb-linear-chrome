{
  "manifest_version": 3,
  "name": "¿Qué sigue?",
  "version": "0.7.2",
  "homepage_url": "https://gabrielneuman.com",
  "description": "Tus issues de Linear y tus recordatorios: qué sigue, qué va a un agente y qué está atorado.",
  "permissions": ["storage", "alarms", "notifications", "identity", "identity.email", "unlimitedStorage"],
  "host_permissions": ["https://api.linear.app/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
